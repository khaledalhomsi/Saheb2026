<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>منصة الإعلانات المبوبة الشاملة</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              primary: '#4F46E5',
              secondary: '#64748B',
              bgCustom: '#F8FAFC',
              cardBg: '#FFFFFF',
              textPrimary: '#0F172A',
              accent: '#06B6D4',
              borderCol: '#E2E8F0'
            }
          }
        }
      }
    </script>
</head>
<body class="bg-bgCustom text-textPrimary font-sans min-h-screen pb-12">

    <!-- رأس الصفحة -->
    <header class="bg-white border-b border-borderCol shadow-sm sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
            <h1 class="text-xl font-bold text-primary">سوق الإعلانات المبوبة</h1>
            <div class="flex gap-2">
                <button onclick="switchTab('home')" class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium">الرئيسية</button>
                <button onclick="switchTab('add')" class="px-4 py-2 bg-accent text-white rounded-lg text-sm font-medium">أضف إعلان</button>
                <button onclick="switchTab('admin')" class="px-4 py-2 bg-secondary text-white rounded-lg text-sm font-medium">لوحة التحكم</button>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 mt-6">

        <!-- القسم الرئيسي والبحث -->
        <section id="home-section" class="tab-content">
            <!-- شريط البحث مع قسم النتائج المخصص أسفله مباشرة -->
            <div class="bg-white p-6 rounded-xl border border-borderCol shadow-sm mb-6">
                <h2 class="text-lg font-semibold mb-3">ابحث عن ما تحتاجه</h2>
                <div class="flex gap-2">
                    <input type="text" id="searchInput" placeholder="اكتب كلمة مفتاحية للبحث..." class="flex-1 border border-borderCol rounded-lg px-4 py-2 focus:outline-none focus:border-primary">
                    <button onclick="executeSearch()" class="bg-primary text-white px-6 py-2 rounded-lg font-medium">بحث</button>
                </div>
                
                <!-- شاشة نتائج البحث المستقلة الموجودة حصرياً مباشرة تحت شريط البحث -->
                <div id="searchResultsContainer" class="mt-4 pt-4 border-t border-borderCol hidden">
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="font-bold text-md text-primary">نتائج البحث المباشرة:</h3>
                        <button onclick="clearSearch()" class="text-xs text-red-500 underline">إغلاق النتائج</button>
                    </div>
                    <div id="searchResultsList" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <!-- تُعرض النتائج هنا -->
                    </div>
                </div>
            </div>

            <!-- قائمة الإعلانات النشطة -->
            <h2 class="text-xl font-bold mb-4">أحدث الإعلانات المنشورة</h2>
            <div id="listingsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                <!-- تحميل الإعلانات ديناميكياً من قاعدة البيانات -->
            </div>
        </section>

        <!-- قسم إضافة إعلان -->
        <section id="add-section" class="tab-content hidden max-w-xl mx-auto bg-white p-6 rounded-xl border border-borderCol shadow-sm">
            <h2 class="text-xl font-bold mb-4">إضافة إعلان جديد</h2>
            <form id="addListingForm" onsubmit="submitListing(event)" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium mb-1">عنوان الإعلان</label>
                    <input type="text" id="title" required class="w-full border border-borderCol rounded-lg px-3 py-2">
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">الوصف</label>
                    <textarea id="description" rows="3" class="w-full border border-borderCol rounded-lg px-3 py-2"></textarea>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">السعر</label>
                        <input type="number" id="price" required class="w-full border border-borderCol rounded-lg px-3 py-2">
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">الفئة</label>
                        <select id="category_id" class="w-full border border-borderCol rounded-lg px-3 py-2">
                            <option value="real_estate">عقارات</option>
                            <option value="vehicles">مركبات</option>
                            <option value="services">خدمات</option>
                            <option value="electronics">إلكترونيات</option>
                            <option value="jobs">وظائف</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">الدولة</label>
                    <select id="country_code" class="w-full border border-borderCol rounded-lg px-3 py-2">
                        <option value="TR">تركيا</option>
                        <option value="SA">المملكة العربية السعودية</option>
                        <option value="AE">الإمارات العربية المتحدة</option>
                        <option value="EG">مصر</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">صورة الإعلان</label>
                    <input type="file" id="imageFile" accept="image/*" class="w-full text-sm text-secondary">
                </div>
                <button type="submit" class="w-full bg-primary text-white py-2 rounded-lg font-medium">نشر الإعلان (محفوظ بقاعدة البيانات)</button>
            </form>
        </section>

        <!-- لوحة التحكم المرتبطة بقاعدة البيانات -->
        <section id="admin-section" class="tab-content hidden bg-white p-6 rounded-xl border border-borderCol shadow-sm">
            <h2 class="text-xl font-bold mb-4">لوحة تحكم الإدارة (تعديل وحذف دائم)</h2>
            <div class="overflow-x-auto">
                <table class="w-full text-right border-collapse">
                    <thead>
                        <tr class="border-b border-borderCol text-secondary text-sm">
                            <th class="py-2">العنوان</th>
                            <th class="py-2">السعر</th>
                            <th class="py-2">الحالة</th>
                            <th class="py-2">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody id="adminTableBody">
                        <!-- يُعبأ عبر الجافاسكريبت -->
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    <script>
        function switchTab(tab) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById(tab + '-section').classList.remove('hidden');
            if(tab === 'home') loadListings();
            if(tab === 'admin') loadAdminListings();
        }

        async function loadListings() {
            const res = await fetch('/api/listings?status=active');
            const data = await res.json();
            const grid = document.getElementById('listingsGrid');
            grid.innerHTML = data.map(item => `
                <div class="bg-white border border-borderCol rounded-xl overflow-hidden shadow-sm">
                    ${item.image_url ? `<img src="${item.image_url}" class="w-full h-40 object-cover">` : '<div class="w-full h-40 bg-gray-100 flex items-center justify-center text-gray-400">لا توجد صورة</div>'}
                    <div class="p-4">
                        <h3 class="font-bold text-lg mb-1">${item.title}</h3>
                        <p class="text-secondary text-sm mb-3 line-clamp-2">${item.description || ''}</p>
                        <div class="flex justify-between items-center font-semibold text-primary">
                            <span>${item.price} ${item.country_code === 'TR' ? 'TRY' : 'USD'}</span>
                            <span class="text-xs bg-gray-100 text-secondary px-2 py-1 rounded">${item.category_id}</span>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        async function executeSearch() {
            const query = document.getElementById('searchInput').value;
            const res = await fetch(`/api/listings?search=${encodeURIComponent(query)}&status=active`);
            const data = await res.json();
            const container = document.getElementById('searchResultsContainer');
            const list = document.getElementById('searchResultsList');
            
            container.classList.remove('hidden');
            list.innerHTML = data.length ? data.map(item => `
                <div class="bg-bgCustom p-3 rounded-lg border border-borderCol">
                    <h4 class="font-bold">${item.title}</h4>
                    <p class="text-xs text-secondary">${item.price} - ${item.category_id}</p>
                </div>
            `).join('') : '<p class="text-sm text-secondary">لا توجد نتائج تطابق بحثك.</p>';
        }

        function clearSearch() {
            document.getElementById('searchInput').value = '';
            document.getElementById('searchResultsContainer').classList.add('hidden');
        }

        async function submitListing(e) {
            e.preventDefault();
            const formData = new FormData();
            formData.append('title', document.getElementById('title').value);
            formData.append('description', document.getElementById('description').value);
            formData.append('price', document.getElementById('price').value);
            formData.append('category_id', document.getElementById('category_id').value);
            formData.append('country_code', document.getElementById('country_code').value);
            
            const imageFile = document.getElementById('imageFile').files[0];
            if (imageFile) {
                formData.append('image', imageFile);
            }

            const res = await fetch('/api/listings', {
                method: 'POST',
                body: formData
            });

            if (res.ok) {
                alert('تم نشر الإعلان بنجاح وحفظه بشكل دائم في قاعدة البيانات!');
                document.getElementById('addListingForm').reset();
                switchTab('home');
            } else {
                alert('حدث خطأ أثناء النشر.');
            }
        }

        async function loadAdminListings() {
            const res = await fetch('/api/listings');
            const data = await res.json();
            const tbody = document.getElementById('adminTableBody');
            tbody.innerHTML = data.map(item => `
                <tr class="border-b border-borderCol">
                    <td class="py-3">${item.title}</td>
                    <td class="py-3">${item.price}</td>
                    <td class="py-3"><span class="px-2 py-1 text-xs rounded bg-blue-50 text-primary">${item.status}</span></td>
                    <td class="py-3 flex gap-2">
                        <button onclick="updateStatus(${item.id}, 'active')" class="text-xs bg-green-500 text-white px-2 py-1 rounded">تفعيل</button>
                        <button onclick="updateStatus(${item.id}, 'rejected')" class="text-xs bg-red-500 text-white px-2 py-1 rounded">رفض/حذف</button>
                    </td>
                </tr>
            `).join('');
        }

        async function updateStatus(id, status) {
            await fetch(`/api/listings/${id}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status })
            });
            loadAdminListings();
        }

        // تحميل الإعلانات عند فتح الصفحة
        loadListings();
    </script>
</body>
</html>
