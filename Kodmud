function addNewFutureServiceField() {
  const container = document.getElementById('futureServicesContainer');
  if (!container) return;
  const div = document.createElement('div');
  div.className = "flex gap-2 items-center bg-white p-2 rounded border";
  div.innerHTML = `
    <input type="text" placeholder="اسم الخدمة/الموقع" class="future-srv-name border rounded p-1 text-xs flex-1">
    <input type="text" placeholder="رابط الربط / مفتاح API" class="future-srv-key border rounded p-1 text-xs flex-1 font-mono">
    <button type="button" onclick="this.parentElement.remove()" class="text-red-600 px-2 font-bold">×</button>
  `;
  container.appendChild(div);
}

function saveSiteSettingsButton(e) {
  if (e) e.preventDefault();
  const siteName = (document.getElementById('configSiteName')?.value || '').trim();
  const siteSubTitle = (document.getElementById('configSiteSubTitle')?.value || '').trim();
  const adminEmail = (document.getElementById('configAdminEmail')?.value || '').trim();
  const showEmail = document.getElementById('configShowEmail')?.checked || false;
  const adminPhone = (document.getElementById('configAdminPhone')?.value || '').trim();
  const showPhone = document.getElementById('configShowPhone')?.checked || false;

  const cloudinaryCloudName = (document.getElementById('configCloudName')?.value || '').trim();
  const cloudinaryApiKey = (document.getElementById('configCloudApiKey')?.value || '').trim();

  const firebaseApiKey = (document.getElementById('configFirebaseApiKey')?.value || '').trim();
  const firebaseAuthDomain = (document.getElementById('configFirebaseAuthDomain')?.value || '').trim();
  const firebaseProjectId = (document.getElementById('configFirebaseProjectId')?.value || '').trim();
  const firebaseStorageBucket = (document.getElementById('configFirebaseStorageBucket')?.value || '').trim();

  const getSocUrl = (id) => document.getElementById(`soc_${id}_url`) ? document.getElementById(`soc_${id}_url`).value.trim() : '';
  const getSocShow = (id) => document.getElementById(`soc_${id}_show`) ? document.getElementById(`soc_${id}_show`).checked : false;

  const socials = {
    telegram: { url: getSocUrl('telegram'), show: getSocShow('telegram') },
    youtube: { url: getSocUrl('youtube'), show: getSocShow('youtube') },
    instagram: { url: getSocUrl('instagram'), show: getSocShow('instagram') },
    whatsapp: { url: getSocUrl('whatsapp'), show: getSocShow('whatsapp') },
    facebook: { url: getSocUrl('facebook'), show: getSocShow('facebook') },
    tiktok: { url: getSocUrl('tiktok'), show: getSocShow('tiktok') },
    snapchat: { url: getSocUrl('snapchat'), show: getSocShow('snapchat') }
  };

  const futureServices = [];
  document.querySelectorAll('#futureServicesContainer > div').forEach(row => {
    const inputs = row.querySelectorAll('input');
    if (inputs.length >= 2 && inputs[0].value.trim()) {
      futureServices.push({ name: inputs[0].value.trim(), key: inputs[1].value.trim() });
    }
  });

  state.siteConfig = {
    ...state.siteConfig,
    siteName,
    siteSubTitle,
    adminEmail,
    showEmail,
    adminPhone,
    showPhone,
    cloudinaryCloudName,
    cloudinaryApiKey,
    firebaseApiKey,
    firebaseAuthDomain,
    firebaseProjectId,
    firebaseStorageBucket,
    socials,
    futureServices
  };

  try {
    localStorage.setItem('sahibinden_site_config', JSON.stringify(state.siteConfig));
  } catch(err){}

  alert("تم حفظ كافة إعدادات المنصات والسحابة وإعدادات الفوتر سحابياً ومحلياً بنجاح ولن تتأثر بمسح الذاكرة المؤقتة!");
  renderView();
}

