async function handleAuthSubmit(e) {
  e.preventDefault();
  const email = (document.getElementById('authEmail')?.value || '').trim();
  const pass = (document.getElementById('authPassword')?.value || '').trim();
  const nameInput = document.getElementById('authName');
  const name = nameInput ? nameInput.value.trim() : '';
  const errDiv = document.getElementById('authErrorMessage');

  if (!email || !pass) return;

  try {
    if (window.firebaseAuthApp) {
      if (state.authMode === 'login') {
        const userCred = await window.firebaseAuthApp.signInWithEmailAndPassword(email, pass);
        state.isAuthenticated = true;
        state.currentUserId = userCred.user.uid;
        state.userProfile.email = userCred.user.email;
      } else {
        const userCred = await window.firebaseAuthApp.createUserWithEmailAndPassword(email, pass);
        state.isAuthenticated = true;
        state.currentUserId = userCred.user.uid;
        state.userProfile.email = userCred.user.email;
        state.userProfile.name = name || email.split('@')[0];
      }
    } else {
      state.isAuthenticated = true;
      state.userProfile.email = email;
      state.userProfile.name = name || email.split('@')[0];
    }

    closeModal();
    updateAuthHeaderUI();
    renderView();
    alert("تم اعتماد وتأكيد المصادقة وحفظ الإعلانات سحابياً ومحلياً بنجاح!");
  } catch(err) {
    if (errDiv) {
      errDiv.innerText = "حدث خطأ في عملية التسجيل/المصادقة: " + (err.message || 'تأكد من البيانات');
      errDiv.classList.remove('hidden');
    }
  }
}

