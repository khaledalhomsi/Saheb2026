function handleNewListingSubmit(e) {
  e.preventDefault();
  const title = (document.getElementById('newTitle')?.value || '').trim();
  const category = document.getElementById('newCategory')?.value || 'real-estate';
  const listingTypeContainer = document.getElementById('newListingTypeContainer');
  const listingType = (listingTypeContainer && !listingTypeContainer.classList.contains('hidden')) ? (document.getElementById('newListingType')?.value || '') : '';
  const price = parseFloat(document.getElementById('newPrice')?.value) || 0;
  const currency = document.getElementById('newCurrency')?.value || 'TL';
  const countryCode = document.getElementById('newPhoneCountryCode')?.value || '90';
  const rawPhone = (document.getElementById('newPhoneNumber')?.value || '').trim();
  const contactMethod = document.getElementById('newContactMethod')?.value || 'all';
  const country = (document.getElementById('newCountry')?.value || 'تركيا').trim();
  const city = (document.getElementById('newCity')?.value || 'إسطنبول').trim();
  const district = (document.getElementById('newDistrict')?.value || '').trim();
  let desc = (document.getElementById('newDesc')?.value || '').trim();

  if (category === 'clothing') {
    const itemPiece = document.getElementById('newClothingType')?.value || 'ملابس';
    const cond = document.getElementById('newClothingCondition')?.value || 'جديد';
    const color = (document.getElementById('newClothingColor')?.value || '').trim();
    const size = (document.getElementById('newClothingSize')?.value || '').trim();
    desc = `[نوع القطعة: ${itemPiece} | الحالة: ${cond}${color ? ' | اللون: ' + color : ''}${size ? ' | المقاس: ' + size : ''}]\n${desc}`;
  }

  const fullPhone = countryCode + rawPhone.replace(/^0+/, '');
  const realDate = getFormattedRealDate();
  const userEmail = state.userProfile.email || 'guest@sahibinden.com';

  const newListingObj = {
    id: 'ad_' + Date.now(),
    ownerId: state.currentUserId,
    title,
    category,
    listingType,
    price,
    currency,
    country,
    city,
    district,
    image: state.uploadedImages.length ? state.uploadedImages[0] : 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?w=600&auto=format&fit=crop&q=60',
    isFeatured: false,
    date: realDate,
    seller: state.userProfile.name || 'مستخدم مسجل',
    phone: fullPhone,
    email: userEmail,
    contactMethod,
    desc
  };

  closeModal();

  if (hasUserFreePublishThisMonth(userEmail)) {
    state.listings.unshift(newListingObj);
    persistListings();
    syncListingToCloud(newListingObj);
    recordUserAdPublish(userEmail);
    alert("تم نشر وحفظ إعلانك سحابياً ومحلياً بنجاح ولن يختفي أبداً!");
    navigateTo('details', newListingObj.id);
  } else {
    state.pendingAdData = newListingObj;
    startGoogleAdWatchFlow();
  }
}

function startGoogleAdWatchFlow() {
  const adModal = document.getElementById('googleAdModal');
  const countSpan = document.getElementById('adCountdownSeconds');
  const btnSubmit = document.getElementById('btnConfirmPublishAfterAd');
  const timerNotice = document.getElementById('adTimerNotice');
  if (!adModal || !countSpan || !btnSubmit) return;

  let secondsLeft = 10;
  countSpan.innerText = secondsLeft;
  btnSubmit.disabled = true;
  btnSubmit.className = "w-full bg-gray-300 text-gray-500 font-extrabold py-3 rounded-xl text-xs sm:text-sm cursor-not-allowed transition shadow-md flex items-center justify-center gap-2";
  btnSubmit.innerHTML = `<i class="fa-solid fa-lock"></i> <span>انتقال لنشر الإعلان (${secondsLeft} ثوانٍ)</span>`;
  if (timerNotice) timerNotice.innerText = "جاري عرض الإعلان... انتظر قليلاً لنشر إعلانك";

  adModal.classList.remove('hidden');
  if (adCountdownInterval) clearInterval(adCountdownInterval);

  adCountdownInterval = setInterval(() => {
    secondsLeft--;
    countSpan.innerText = secondsLeft;
    if (secondsLeft <= 0) {
      clearInterval(adCountdownInterval);
      btnSubmit.disabled = false;
      btnSubmit.className = "w-full bg-sahibinden-yellow hover:bg-yellow-400 text-black font-black py-3 rounded-xl text-xs sm:text-sm cursor-pointer transition shadow-xl flex items-center justify-center gap-2 transform hover:scale-105";
      btnSubmit.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-700"></i> <span>تم اكتمال مشاهدة الإعلان - انقر هنا لنشر إعلانك الآن!</span>`;
      if (timerNotice) timerNotice.innerText = "اكتمل العداد! يمكنك الآن النشر المباشر.";
    } else {
      btnSubmit.innerHTML = `<i class="fa-solid fa-lock"></i> <span>انتقال لنشر الإعلان (${secondsLeft} ثوانٍ)</span>`;
    }
  }, 1000);
}

function executeAdPublishing() {
  const adModal = document.getElementById('googleAdModal');
  if (adModal) adModal.classList.add('hidden');

  if (state.pendingAdData) {
    const publishedItem = state.pendingAdData;
    state.listings.unshift(publishedItem);
    persistListings();
    syncListingToCloud(publishedItem);
    recordUserAdPublish(state.userProfile.email || 'user@sahibinden.com');
    state.pendingAdData = null;
    alert("تم نشر وحفظ إعلانك سحابياً ومحلياً بنجاح!");
    navigateTo('details', publishedItem.id);
  }
}

function handleInstantSearch(e) {
  const val = e.target.value.trim().toLowerCase();
  const dropdown = document.getElementById('searchDropdown');
  if (!dropdown) return;
  if (!val) {
    dropdown.classList.add('hidden');
    dropdown.innerHTML = '';
    return;
  }
  const matches = state.listings.filter(l => 
    l.title.toLowerCase().includes(val) || 
    l.city.toLowerCase().includes(val) ||
    l.district.toLowerCase().includes(val) ||
    (categoryNames[l.category] && categoryNames[l.category].toLowerCase().includes(val))
  ).slice(0, 5);

  if (matches.length === 0) {
    dropdown.innerHTML = `<div class="p-3 text-xs text-gray-500 font-bold text-center">لا توجد نتائج مطابقة</div>`;
  } else {
    dropdown.innerHTML = matches.map(m => `
      <div onclick="setSearchTerm('${m.title}')" class="p-2.5 hover:bg-yellow-50 flex items-center justify-between cursor-pointer transition">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-gray-800">${m.title}</span>
          ${m.listingType ? `<span class="bg-amber-100 text-amber-800 text-[10px] px-1.5 py-0.5 rounded font-extrabold">${listingTypeNames[m.listingType] || m.listingType}</span>` : ''}
        </div>
        <span class="text-xs text-sahibinden-blue font-mono font-bold">${m.price.toLocaleString()} ${m.currency}</span>
      </div>
    `).join('');
  }
  dropdown.classList.remove('hidden');
}

function setSearchTerm(term) {
  const input = document.getElementById('searchInput');
  if (input) input.value = term;
  triggerSearch();
}

function triggerSearch() {
  const input = document.getElementById('searchInput');
  if (!input) return;
  const val = input.value.trim();
  input.blur();
  const dropdown = document.getElementById('searchDropdown');
  if (dropdown) dropdown.classList.add('hidden');

  if (val) {
    state.searchQuery = val;
    state.isSearchActiveView = true;
    renderView();
  }
}

function clearSearch() {
  state.searchQuery = '';
  state.isSearchActiveView = false;
  const input = document.getElementById('searchInput');
  if (input) input.value = '';
  renderView();
}

function toggleVoiceSearch() {
  const status = document.getElementById('voiceSearchStatus');
  if (!status) return;
  if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    const recognition = new SpeechRecognition();
    recognition.lang = 'ar-SA';
    status.classList.remove('hidden');
    recognition.start();

    recognition.onresult = function(event) {
      const transcript = event.results[0][0].transcript;
      const input = document.getElementById('searchInput');
      if (input) input.value = transcript;
      status.classList.add('hidden');
      triggerSearch();
    };
    recognition.onerror = function() {
      status.classList.add('hidden');
      alert("تعذر التقاط الصوت، يمكنك الكتابة في حقل البحث مباشرة.");
    };
    recognition.onend = function() {
      status.classList.add('hidden');
    };
  } else {
    alert("خاصية البحث الصوتي غير مدعومة في هذا المتصفح.");
  }
}

