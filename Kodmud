function getCurrentMonthKey() {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
}

function getFormattedRealDate() {
  const d = new Date();
  return `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`;
}

function getUserAdPublishHistory(email) {
  if (!email) return [];
  try {
    const raw = localStorage.getItem(`user_pub_history_${email}`);
    return raw ? JSON.parse(raw) : [];
  } catch(e) {
    return [];
  }
}

function recordUserAdPublish(email) {
  if (!email) return;
  const history = getUserAdPublishHistory(email);
  history.push({
    timestamp: Date.now(),
    dateStr: getFormattedRealDate(),
    monthKey: getCurrentMonthKey()
  });
  localStorage.setItem(`user_pub_history_${email}`, JSON.stringify(history));
}

function hasUserFreePublishThisMonth(email) {
  if (!email) return true;
  const history = getUserAdPublishHistory(email);
  const currentMonthKey = getCurrentMonthKey();
  return history.filter(item => item.monthKey === currentMonthKey).length === 0;
}

