            const snap = await window.firebaseDb.collection('global_listings').get();
            if (!snap.empty) {
              const cloudItems = [];
              snap.forEach(doc => cloudItems.push(doc.data()));
              if (cloudItems.length > 0) {
                state.listings = cloudItems;
                persistListings();
              }
            } else {
              // Upload initial state to cloud if empty
              state.listings.forEach(item => {
                window.firebaseDb.collection('global_listings').doc(item.id).set(item);
              });
            }
          } catch(err) {
