function handleDragStart(e, index) {
  state.draggedListingIndex = index;
  e.dataTransfer.effectAllowed = 'move';
}

function handleDragOver(e) {
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
}

function handleDrop(e, targetIndex) {
  e.preventDefault();
  const sourceIndex = state.draggedListingIndex;
  if (sourceIndex !== null && sourceIndex !== targetIndex) {
    const draggedItem = state.listings.splice(sourceIndex, 1)[0];
    state.listings.splice(targetIndex, 0, draggedItem);
    state.draggedListingIndex = null;
    persistListings();
    renderView();
  }
}

function handleDragEnd(e) {
  state.draggedListingIndex = null;
}

function moveListingToTop(id) {
  const idx = state.listings.findIndex(l => l.id === id);
  if (idx > 0) {
    const item = state.listings.splice(idx, 1)[0];
    state.listings.unshift(item);
    persistListings();
    renderView();
  }
}

function moveListingUp(id) {
  const idx = state.listings.findIndex(l => l.id === id);
  if (idx > 0) {
    const temp = state.listings[idx];
    state.listings[idx] = state.listings[idx - 1];
    state.listings[idx - 1] = temp;
    persistListings();
    renderView();
  }
}

function moveListingDown(id) {
  const idx = state.listings.findIndex(l => l.id === id);
  if (idx !== -1 && idx < state.listings.length - 1) {
    const temp = state.listings[idx];
    state.listings[idx] = state.listings[idx + 1];
    state.listings[idx + 1] = temp;
    persistListings();
    renderView();
  }
}

function toggleFeaturedListing(id) {
  const item = state.listings.find(l => l.id === id);
  if (item) {
    item.isFeatured = !item.isFeatured;
    persistListings();
    syncListingToCloud(item);
    renderView();
  }
}

function navigateTo(view, id) {
  state.activeView = view;
  if (id) {
    const item = state.listings.find(l => l.id === id);
    if (item) state.selectedListing = item;
  }
  window.scrollTo({ top: 0, behavior: 'smooth' });
  renderView();
}

function openModalCard(html) {
  const m = document.getElementById('customModal');
  const c = document.getElementById('modalCard');
  if (m && c) {
    c.innerHTML = html;
    m.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
}

function closeModal() {
  const m = document.getElementById('customModal');
  if (m) {
    m.classList.add('hidden');
    document.body.style.overflow = '';
  }
}

function updateFooterUI() {
  const cfg = state.siteConfig;
  const brand = document.getElementById('footerBrandName');
  const desc = document.getElementById('footerDescText');
  const keywords = document.getElementById('footerKeywordsContainer');
  const emailBox = document.getElementById('footerEmailBox');
  const phoneBox = document.getElementById('footerPhoneBox');
  const copy = document.getElementById('footerCopyrightText');
  const socialBar = document.getElementById('footerSocialBar');

  if (brand) brand.innerText = cfg.siteName;
  if (desc) desc.innerText = cfg.footerDesc;
  if (copy) copy.innerText = cfg.footerCopyright;

  if (keywords) {
    const kwArr = cfg.footerKeywords.split(',').map(s => s.trim()).filter(Boolean);
    keywords.innerHTML = kwArr.map(k => `<span class="bg-gray-800 text-gray-300 text-[10px] px-2 py-1 rounded border border-gray-700">${k}</span>`).join('');
  }

  if (emailBox) {
    if (cfg.showEmail) {
      emailBox.classList.remove('hidden');
      document.getElementById('footerEmailText').innerText = cfg.adminEmail;
      document.getElementById('footerEmailLink').href = `mailto:${cfg.adminEmail}`;
    } else {
      emailBox.classList.add('hidden');
    }
  }

  if (phoneBox) {
    if (cfg.showPhone) {
      phoneBox.classList.remove('hidden');
      document.getElementById('footerPhoneText').innerText = cfg.adminPhone;
      document.getElementById('footerPhoneLink').href = `tel:${cfg.adminPhone}`;
    } else {
      phoneBox.classList.add('hidden');
    }
  }

  if (socialBar) {
    const soc = cfg.socials || {};
    const iconsMap = {
      telegram: { icon: 'fa-telegram', color: 'bg-sky-500' },
      youtube: { icon: 'fa-youtube', color: 'bg-red-600' },
      instagram: { icon: 'fa-instagram', color: 'bg-pink-600' },
      whatsapp: { icon: 'fa-whatsapp', color: 'bg-emerald-500' },
      facebook: { icon: 'fa-facebook', color: 'bg-blue-600' },
      tiktok: { icon: 'fa-tiktok', color: 'bg-black' },
      snapchat: { icon: 'fa-snapchat', color: 'bg-yellow-500 text-black' }
    };
    let html = '';
    Object.keys(iconsMap).forEach(key => {
      if (soc[key] && soc[key].show && soc[key].url) {
        html += `<a href="${soc[key].url}" target="_blank" class="${iconsMap[key].color} ${key === 'snapchat' ? 'text-black' : 'text-white'} w-7 h-7 rounded-full flex items-center justify-center hover:opacity-80 transition text-xs"><i class="fa-brands ${iconsMap[key].icon}"></i></a>`;
      }
    });
    socialBar.innerHTML = html;
  }
}

function renderView() {
  updateFooterUI();
  const main = document.getElementById('appMain');
  if (!main) return;

  if (state.activeView === 'home') {
    main.innerHTML = getHomeHTML();
  } else if (state.activeView === 'admin') {
    main.innerHTML = getAdminHTML();
  } else if (state.activeView === 'details') {
    main.innerHTML = getDetailsHTML();
  } else if (state.activeView === 'my-listings') {
    main.innerHTML = getMyListingsHTML();
  }
}

